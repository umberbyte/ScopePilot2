<Window x:Class="ScopePilot.NewProjectFolderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新規プロジェクトフォルダーを作成" Width="560" Height="260" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI, Yu Gothic UI" FontSize="14">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles/Controls.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <StackPanel Margin="24" Background="{DynamicResource WindowBackground}">
        <TextBlock Text="新規プロジェクトフォルダー名" FontWeight="SemiBold" />
        <TextBox x:Name="FolderNameBox" Text="新しいプロジェクト" AutomationProperties.Name="新規フォルダー名" />
        <TextBlock Text="このフォルダー内にproject.scopepilot.jsonを生成します。" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16" />
        <WrapPanel HorizontalAlignment="Right">
            <Button Content="作成" Click="Create_Click" IsDefault="True" Style="{StaticResource PrimaryActionButton}" />
            <Button Content="キャンセル" IsCancel="True" Margin="0" />
        </WrapPanel>
    </StackPanel>
</Window>
