{
  "name": "scopepilot2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:workspaces",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test:simulation": "npm run test --workspace @scopepilot2/simulation --if-present",
    "test:fixture": "npm run test:fixture --workspace @scopepilot2/simulation --if-present && npm run test:fixture --workspace @scopepilot2/guideline-catalog --if-present"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron@44.9.0": true
  }
}
