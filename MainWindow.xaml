<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ScopePilot.MainWindow" Title="ScopePilot" Width="1360" Height="900" MinWidth="960" MinHeight="700" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI, Yu Gothic UI" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" PreviewKeyDown="Window_PreviewKeyDown" Binding.SourceUpdated="Window_SourceUpdated">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ApiOnly" TargetType="FrameworkElement">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding IsApiMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="WebOnly" TargetType="FrameworkElement">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers><DataTrigger Binding="{Binding IsApiMode}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="WebGroupBox" TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
                <Style.Triggers><DataTrigger Binding="{Binding IsApiMode}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="ApiGroupBox" TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding IsApiMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="AuthenticationIdleAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Style.Triggers><DataTrigger Binding="{Binding AuthenticationWaiting}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="ZapOnly" TargetType="FrameworkElement">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding IsZapTarget}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="BurpOnly" TargetType="FrameworkElement">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers><DataTrigger Binding="{Binding IsZapTarget}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,24,12,16">
                <StackPanel DockPanel.Dock="Top" Margin="12,0,12,24">
                    <TextBlock Text="ScopePilot" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="診断対象の整理" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="12,16,12,0">
                    <TextBlock Text="BURP / ZAP" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
                <ListBox x:Name="Navigation" BorderThickness="0" Background="Transparent" Margin="0" Padding="0" SelectedIndex="0" SelectionChanged="Navigation_SelectionChanged" AutomationProperties.Name="画面の切り替え">
                    <ListBoxItem IsEnabled="False" Focusable="False" Padding="12,4" Margin="0,0,0,8">
                        <TextBlock Text="作業の流れ" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                    </ListBoxItem>
                    <ListBoxItem Tag="0" Content="1   案件設定" />
                    <ListBoxItem Tag="1" Content="{Binding ExecutionNavigationText}" />
                    <ListBoxItem Tag="{Binding ReviewPageTag}" Content="{Binding ReviewNavigationText}" />
                    <ListBoxItem Tag="6" Content="4   診断ツールへ" />
                    <ListBoxItem IsEnabled="False" Focusable="False" Padding="12,4" Margin="0,24,0,8">
                        <TextBlock Text="記録と管理" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                    </ListBoxItem>
                    <ListBoxItem Tag="2" Content="観測した通信" />
                    <ListBoxItem Tag="4" Content="診断所見" />
                    <ListBoxItem Tag="5" Content="実行履歴" />
                    <ListBoxItem Tag="7" Content="データ管理" />
                    <ListBoxItem Tag="9" Content="アプリ設定" />
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,20">
                <Button DockPanel.Dock="Right" Content="案件を保存" Command="{Binding SaveCommand}" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="Ctrl+S" />
                <StackPanel>
                    <TextBlock Text="{Binding SelectedItem.Header, ElementName=Workspace}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedItem.Tag, ElementName=Workspace}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Background="{DynamicResource InfoBackground}" CornerRadius="6" Padding="12,9" Margin="0,0,0,16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontWeight="SemiBold" Margin="16,0,0,0" />
                    <TextBlock Text="{Binding SummaryText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SummaryText}" />
                </DockPanel>
            </Border>
            <TabControl x:Name="Workspace" Grid.Row="2" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimary}" SelectedIndex="0" KeyboardNavigation.TabNavigation="Local">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="案件設定" Tag="対象範囲と参照基準を設定して、探索の準備をします。">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button Content="新規プロジェクトフォルダー" Command="{Binding NewProjectCommand}" />
                            <Button Content="保存" Command="{Binding SaveCommand}" AutomationProperties.Name="案件設定を保存" />
                            <Button Content="{Binding ExecutionNextText}" Tag="1" Click="Navigate_Click" Style="{StaticResource PrimaryActionButton}" />
                        </WrapPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
                            <StackPanel x:Name="SettingsForm" MaxWidth="880" HorizontalAlignment="Left" Margin="0" Style="{StaticResource EditableWhenIdle}" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                <GroupBox x:Name="ProjectFileSection" Header="プロジェクトフォルダー" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock x:Name="ProjectLocationLabel" Text="{Binding ProjectLocation}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                        <TextBlock Text="{Binding SaveStateText}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12" />
                                        <WrapPanel>
                                            <Button x:Name="OpenProjectFileButton" Content="フォルダーを開く" Command="{Binding LoadProjectCommand}" MinWidth="140" Margin="0,0,8,0" />
                                            <Button x:Name="ImportLegacyProjectButton" Content="旧案件を移行" Click="ImportLegacyProject_Click" MinWidth="140" Margin="0" />
                                        </WrapPanel>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="基本情報" Margin="0,0,0,16" IsEnabled="{Binding CanEditExplorationSettings}">
                                    <StackPanel>
                                        <TextBlock Text="入力モード" />
                                        <ListBox Style="{StaticResource ChoiceList}" SelectedIndex="{Binding ProjectModeIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" AutomationProperties.Name="入力モード">
                                            <ListBoxItem Content="Web探索（クローリング）" />
                                            <ListBoxItem Content="APIドキュメント（リクエスト生成）" />
                                        </ListBox>
                                        <TextBlock Text="案件名" />
                                        <TextBox Text="{Binding Project.Name, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" AutomationProperties.Name="案件名" />
                                        <StackPanel Style="{StaticResource WebOnly}">
                                            <TextBlock Text="開始URL" />
                                            <TextBox Text="{Binding Project.StartUrl, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" AutomationProperties.Name="開始URL" />
                                            <TextBlock Text="認証後の開始URL（任意）" Margin="0,8,0,0" />
                                            <TextBox Text="{Binding Project.AfterAuthenticationUrl, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" AutomationProperties.Name="認証後の開始URL" />
                                            <TextBlock Style="{StaticResource Hint}" Text="指定があればログイン後にそのURLへ移動します。空欄では実際の遷移先を確認します。許可Origin内のURLを指定してください。" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Hint}" Text="Originは「https://example.com」のように、スキーム・ホスト・ポートで指定します。パスは含めません。" />
                                        <TextBlock Text="診断を許可されたOrigin（1行1件）" />
                                        <TextBox Text="{Binding Project.AllowedOrigins, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" Height="86" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="診断を許可されたOrigin" />
                                        <StackPanel Style="{StaticResource WebOnly}">
                                            <TextBlock Text="表示・認証に必要だが診断対象外のOrigin" />
                                            <TextBox Text="{Binding Project.SupportingOrigins, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="診断対象外のOrigin" />
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox x:Name="ExplorationAiSection" Header="画面探索のAI" Margin="0,0,0,16" Style="{StaticResource WebGroupBox}" IsEnabled="{Binding CanEditExplorationSettings}">
                                    <StackPanel>
                                        <ListBox Style="{StaticResource ChoiceList}" SelectedIndex="{Binding ExplorationAiIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" AutomationProperties.Name="画面探索のAI">
                                            <ListBoxItem Content="Codex CLI" /><ListBoxItem Content="GLM（Z.ai・zcode）" />
                                        </ListBox>
                                        <TextBlock Text="モデル" />
                                        <ComboBox ItemsSource="{Binding ExplorationAiModelOptions}" SelectedItem="{Binding ExplorationAiModelLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" IsEnabled="{Binding ExplorationAiModelEnabled}" Margin="0,4,0,8" AutomationProperties.Name="画面探索のAIモデル" />
                                        <TextBlock Style="{StaticResource Hint}" Text="リンク巡回の後、このAIがPlaywright MCPで探索ブラウザを操作し、代表パターンの機能を確認します。どちらのAIでも、使えるブラウザ操作は閲覧・スナップショット・画面遷移・通信一覧・スクリーンショットに限られ、シェル・ファイル操作・Web取得は使えません。GLMはzcode CLI（アプリ設定のAPIキー、またはzcode login のサインイン）で実行し、許可外のMCPツールはアプリのフィルターで遮断します。GLMは途中経過を出力しないため、結果は終了時に表示されます。" />
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox x:Name="ExplorationDocumentSection" Header="入力ドキュメント（仕様書・操作手順）" Margin="0,0,0,16" Style="{StaticResource WebGroupBox}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Hint}" Text="対象の仕様書・操作手順を選択したAIの機能理解に使用します。Markdown・TXT・HTML・JSON・YAMLのUTF-8文書（最大250,000文字）を選択できます。PDF・Wordはテキストへ変換してください。" />
                                        <TextBlock x:Name="ExplorationDocumentLabel" Text="{Binding ExplorationDocumentName}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                        <WrapPanel>
                                            <Button x:Name="ReadExplorationDocumentButton" Content="ドキュメントを選択" Click="ReadExplorationDocument_Click" Height="38" Margin="0,0,8,0" AutomationProperties.Name="クローリング用の入力ドキュメントを選択" />
                                            <Button Content="指定を解除" Command="{Binding ClearExplorationDocumentCommand}" Height="38" Margin="0" />
                                        </WrapPanel>
                                        <TextBlock Text="文書を読み取るAI" Margin="0,8,0,0" />
                                        <ListBox Style="{StaticResource ChoiceList}" SelectedIndex="{Binding DocProviderIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" AutomationProperties.Name="探索用ドキュメントのAI">
                                            <ListBoxItem Content="Codex CLI" /><ListBoxItem Content="Claude Code CLI" /><ListBoxItem Content="GLM（Z.ai・zcode）" />
                                        </ListBox>
                                        <TextBlock Text="モデル" />
                                        <ComboBox ItemsSource="{Binding DocModelOptions}" SelectedItem="{Binding DocModelLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" Margin="0,4,0,8" AutomationProperties.Name="探索用ドキュメントのAIモデル" />
                                        <TextBlock Text="推論レベル" />
                                        <ComboBox ItemsSource="{Binding DocReasoningOptions}" SelectedIndex="{Binding DocReasoningIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" IsEnabled="{Binding DocReasoningEnabled}" Margin="0,4,0,8" AutomationProperties.Name="探索用ドキュメントのAI推論レベル" />
                                        <TextBlock Style="{StaticResource Hint}" Text="このAIが文書から探索の補助情報（クローリングでは辿り着かないAPI・管理ページ、認証情報の所在、優先規則、APIパラメーターのバリエーション）を抽出します。Codex CLIとClaude Code CLIはインストールとログインが必要です。GLMはzcode CLI（npmグローバル）を使用し、アプリ設定のAPIキー、またはzcode login のZ.aiサインインで実行します。推論レベルはzcode側の設定に従います。抽出に失敗しても探索は続行します。" />
                                        <TextBlock Style="{StaticResource Hint}" Text="文書はプロジェクトフォルダーへコピーし、探索時にAIへ渡します。選択・解除した設定は［保存］で保存してください。" Margin="0,8,0,0" />
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox x:Name="ExplorationProxySection" Header="探索用プロキシ" Margin="0,0,0,16" Style="{StaticResource WebGroupBox}" IsEnabled="{Binding CanEditExplorationSettings}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Hint}" Text="自動ではBurpへの接続を確認し、接続できない場合はZAPを起動します。探索後の引き渡し先は［診断ツールへ］で別に指定できます。" />
                                        <ListBox Style="{StaticResource ChoiceList}" SelectedIndex="{Binding ExplorationProxyModeIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" AutomationProperties.Name="探索用プロキシ">
                                            <ListBoxItem Content="自動（Burpを優先、接続不可ならZAP）" />
                                            <ListBoxItem Content="Burp" />
                                            <ListBoxItem Content="ZAP" />
                                        </ListBox>
                                        <TextBlock Text="BurpのプロキシURL" />
                                        <TextBox Text="{Binding Project.ExplorationProxy.BurpProxyUrl, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" AutomationProperties.Name="BurpのプロキシURL" />
                                        <TextBlock Text="ZAPのポート（0は自動割当）" Margin="0,8,0,0" />
                                        <TextBox Text="{Binding Project.ExplorationProxy.ZapPort, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" AutomationProperties.Name="ZAPの探索用ポート" />
                                        <TextBlock Text="ZAPのJAR" Margin="0,8,0,0" />
                                        <Grid Margin="0,4,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Project.DiagnosticTools.ZapJarPath, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" Height="38" Margin="0,0,8,0" AutomationProperties.Name="探索用ZAPのJAR" />
                                            <Button Grid.Column="1" Content="JARを選択" Click="ChooseZapJar_Click" Height="38" MinWidth="96" Margin="0" />
                                        </Grid>
                                        <TextBlock Text="Javaのjava.exe" />
                                        <Grid Margin="0,4,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Project.DiagnosticTools.JavaPath, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" Height="38" Margin="0,0,8,0" AutomationProperties.Name="探索用ZAPのJava" />
                                            <Button Grid.Column="1" Content="Javaを選択" Click="ChooseJava_Click" Height="38" MinWidth="96" Margin="0" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource Hint}" Text="ZAPと対応するJavaを別途導入して指定します。ここを空欄にするとアプリ設定（アプリ設定画面）の既定パスを使用します。この実行ファイル設定は引き渡し画面でも使用します。ZAPは探索ごとにSafeモードで起動し、終了時に停止します。設定は［保存］で保存してください。" />
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="APIドキュメント" Margin="0,0,0,16" Style="{StaticResource ApiGroupBox}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Hint}" Text="OpenAPI / SwaggerのJSON・YAML、Postman Collection、Markdown・HTML・TXTのAPI仕様書を読み込みます。文書は選択したAIへ渡され、案件と実行履歴にも保存されます。" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="ドキュメントを選択" Click="ReadApiDocument_Click" />
                                            <TextBlock Text="{Binding ApiDocumentName}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="APIベースURL（例: https://api.example.com/v1）" />
                                        <TextBox Text="{Binding Project.ApiDocument.BaseUrl, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" AutomationProperties.Name="APIベースURL" />
                                        <TextBlock Text="文書を読み取るAI" />
                                        <ListBox Style="{StaticResource ChoiceList}" SelectedIndex="{Binding ApiProviderIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" AutomationProperties.Name="APIドキュメントのAI">
                                            <ListBoxItem Content="Codex CLI" /><ListBoxItem Content="Claude Code CLI" /><ListBoxItem Content="GLM（Z.ai・zcode）" />
                                        </ListBox>
                                        <TextBlock Text="モデル" />
                                        <ComboBox ItemsSource="{Binding ApiModelOptions}" SelectedItem="{Binding ApiModelLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" Margin="0,4,0,8" AutomationProperties.Name="APIドキュメントのAIモデル" />
                                        <TextBlock Text="推論レベル" />
                                        <ComboBox ItemsSource="{Binding ApiReasoningOptions}" SelectedIndex="{Binding ApiReasoningIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" IsEnabled="{Binding ApiReasoningEnabled}" Margin="0,4,0,8" AutomationProperties.Name="APIドキュメントのAI推論レベル" />
                                        <TextBlock Style="{StaticResource Hint}" Text="Codex CLIとClaude Code CLIはインストールとログインが必要です。GLMはzcode CLI（npmグローバル）を使用し、アプリ設定のAPIキー、またはzcode login のZ.aiサインインで実行します。推論レベルはzcode側の設定に従うため選択できません。推論レベルはモデルの思考量（Highest/High/Middle/Low）です。生成件数には通信上限、生成時間には実行時間上限を使用します。生成し直すと下書き一覧が置き換わります。" />
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="アカウントと操作制限" Margin="0,0,0,16" IsEnabled="{Binding CanEditExplorationSettings}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Hint}" Text="探索で扱う利用者の区分（ロール）と、自動では実行させない操作を決めます。アプリは自動ログインをしません。ログイン画面を見つけたら探索を止めて、あなたに探索ブラウザでのログインを依頼します。パスワードなどの認証情報はこの画面に書かないでください。" />

                                        <TextBlock Text="認証ロール（1行1件）" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding Project.Roles, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" Height="70" AcceptsReturn="True" TextChanged="RolesTextBox_TextChanged" AutomationProperties.Name="認証ロール" />
                                        <Border Background="{DynamicResource InfoBackground}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,-8,0,16">
                                            <StackPanel>
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"><Run Text="記入するもの：" FontWeight="SemiBold" /><Run Text="対象アプリの利用者区分の名前（例：一般ユーザー、管理者）。改行またはカンマで区切ります。" /></TextBlock>
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"><Run Text="判断のしかた：" FontWeight="SemiBold" /><Run Text="書いた名前がそのまま下の「今回探索するロール」とログイン待ちの「認証後のロール」の選択肢になります。重複は1つにまとめ、「未認証」は書かなくても先頭に必ず追加します。名前は記録用のラベルで、アプリが権限を確かめることはありません。" /></TextBlock>
                                                <TextBlock TextWrapping="Wrap"><Run Text="結果：" FontWeight="SemiBold" /><Run Text="観測した通信・候補・所見に、どのロールで得たかのラベルとして付きます。同じURLでもロールが違えば別の記録として巡回・保存します。" /></TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="今回探索するロール" FontWeight="SemiBold" />
                                        <ListBox Style="{StaticResource ChoiceList}" ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding ActiveRole, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" AutomationProperties.Name="今回探索するロール" />
                                        <Border Background="{DynamicResource InfoBackground}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,16" Style="{StaticResource WebOnly}">
                                            <StackPanel>
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"><Run Text="選ぶもの：" FontWeight="SemiBold" /><Run Text="この実行で、ログイン後に扱いたい利用者区分。" /></TextBlock>
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"><Run Text="判断のしかた：" FontWeight="SemiBold" /><Run Text="リンク巡回は選択に関係なく、常に「未認証」として始めます。ログイン画面（URL・ページタイトル・パスワード欄から判定）を見つけたら、選んだロールに関係なく巡回を止めて、探索ブラウザでのログインを依頼します。ログイン後、アプリでロールを選んで再開すると、ログアウトのリンクなどログイン状態の表示があることを確かめてから続行します。確かめられないときは、再度ログインを依頼します。" /></TextBlock>
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"><Run Text="この選択の効き方：" FontWeight="SemiBold" /><Run Text="未認証以外を選ぶと、ログイン待ちで表示する「認証後のロール」の初期値になります。実際の記録に使われるのは、再開時に選んだロールです。ログイン前の通信は「未認証」、ログイン後の通信はそのロールとして記録します。" /></TextBlock>
                                                <TextBlock TextWrapping="Wrap"><Run Text="結果：" FontWeight="SemiBold" /><Run Text="実行記録（engagement.json）、AIへの指示、保存する証跡ファイル（HARなど）のラベル、診断ツールへの引き渡しに、このロールを使います。個々の通信のロールは上の判断で付き、ログインが一度も必要にならなかった場合はすべて「未認証」です（巡回記録と照合できない通信は「認証状態未確認」）。" /></TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource InfoBackground}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,16" Style="{StaticResource ApiOnly}">
                                            <TextBlock TextWrapping="Wrap"><Run Text="APIドキュメントモード：" FontWeight="SemiBold" /><Run Text="選んだロールを、生成するリクエストの下書きとAIへの指示に記録します。ログインの代行や認証情報の補完は行いません。トークンなどの値は、下書きの置換値で確認・補完してください。" /></TextBlock>
                                        </Border>

                                        <TextBlock Text="自動実行しない操作（1行1件）" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding Project.ForbiddenActions, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" Height="120" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="自動実行しない操作" />
                                        <Border Background="{DynamicResource InfoBackground}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,-8,0,0">
                                            <StackPanel>
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"><Run Text="記入するもの：" FontWeight="SemiBold" /><Run Text="自動では実行させたくない操作を表す語句（例：削除、購入・決済）。画面上のリンクやボタンに表示される言葉で書きます。" /></TextBlock>
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"><Run Text="判断のしかた：" FontWeight="SemiBold" /><Run Text="リンク巡回で見つけたリンクの表示文字に、この語句が含まれるか（部分一致・英字の大文字小文字は区別しない）で判定します。URLとは照合しません。これとは別に、ログアウト・削除・購入・決済・申請・承認・リセットなどは、URLと表示文字の組み込みルールで常に除外します。" /></TextBlock>
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"><Run Text="結果：" FontWeight="SemiBold" /><Run Text="該当するリンクは辿らず、巡回記録（crawl-coverage.json）に「forbidden-action」として残します。画面探索のAIにも禁止事項として渡します（AIはクリック・入力・送信のツール自体を使えません）。報告書にも「自動実行しない操作」として載ります。" /></TextBlock>
                                                <TextBlock TextWrapping="Wrap"><Run Text="注意：" FontWeight="SemiBold" /><Run Text="「探索条件」でフォーム送信を有効にした場合、送信してよいかの判定にはこの語句を使いません。判定はURLの組み込みルールと、パスワード欄・ファイル欄の有無で行います。" /></TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="探索条件" Margin="0,0,0,16" IsEnabled="{Binding CanEditExplorationSettings}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="MaxPageLabel" Text="最大ページ数" Style="{StaticResource WebOnly}" />
                                        <TextBox Grid.Column="1" Text="{Binding Project.MaxPages}" AutomationProperties.Name="最大ページ数" Visibility="{Binding Visibility, ElementName=MaxPageLabel}" />
                                        <TextBlock Grid.Row="1" Text="最大実行時間（分）" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Project.MaxMinutes}" AutomationProperties.Name="最大実行時間（分）" />
                                        <TextBlock Grid.Row="2" Text="{Binding RequestLimitLabel}" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Project.MaxRequests}" AutomationProperties.Name="最大通信数" />
                                        <CheckBox Grid.Row="3" Grid.ColumnSpan="2" IsChecked="{Binding CrawlFormSubmissions, Mode=TwoWay}" Margin="0,8,0,0" AutomationProperties.Name="フォーム送信を含める">
                                            <TextBlock Text="フォーム送信を含める（無害な仮値で各フォームを1回送信し、通信をHARに記録。ログイン・アップロード・禁止操作フォームは除外）" TextWrapping="Wrap" />
                                        </CheckBox>
                                    </Grid>
                                </GroupBox>
                                <GroupBox Header="参照するガイドライン" Margin="0,0,0,16" Style="{StaticResource WebGroupBox}">
                                    <StackPanel>
                                        <TextBlock Text="チェックを外した資料は、候補選定・根拠表示・Codexへのコンテキストに使用しません。" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" />
                                        <CheckBox IsChecked="{Binding Project.Guidelines.WebAppPentestGuidelines, Mode=TwoWay, NotifyOnSourceUpdated=True}" Click="GuidelineCheckBox_Click" Margin="0,3">
                                            <TextBlock Text="Webアプリケーション脆弱性診断ガイドライン 第1.2版" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding Project.Guidelines.OwaspTop10, Mode=TwoWay, NotifyOnSourceUpdated=True}" Click="GuidelineCheckBox_Click" Margin="0,3">
                                            <TextBlock Text="OWASP Top 10:2025" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding Project.Guidelines.Asvs, Mode=TwoWay, NotifyOnSourceUpdated=True}" Click="GuidelineCheckBox_Click" Margin="0,3">
                                            <TextBlock Text="OWASP ASVS 5.0" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding Project.Guidelines.Wstg, Mode=TwoWay, NotifyOnSourceUpdated=True}" Click="GuidelineCheckBox_Click" Margin="0,3">
                                            <TextBlock Text="OWASP WSTG 4.2" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding Project.Guidelines.Aisvs, Mode=TwoWay, NotifyOnSourceUpdated=True}" Click="GuidelineCheckBox_Click" Margin="0,3">
                                            <TextBlock Text="OWASP AISVS 1.0（AI機能がある案件）" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding Project.Guidelines.CloudNativeTop10, Mode=TwoWay, NotifyOnSourceUpdated=True}" Click="GuidelineCheckBox_Click" Margin="0,3">
                                            <TextBlock Text="OWASP Cloud Native Application Security Top 10" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding Project.Guidelines.Ds221, Mode=TwoWay, NotifyOnSourceUpdated=True}" Click="GuidelineCheckBox_Click" Margin="0,3">
                                            <TextBlock Text="デジタル庁 DS-221" TextWrapping="Wrap" />
                                        </CheckBox>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
                <TabItem Header="{Binding ExecutionPageHeader}" Tag="{Binding RunModeDescription}">
                    <Grid Margin="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource InfoBackground}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" Padding="14" CornerRadius="4">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="{Binding RunModeDescription}" />
                                <TextBlock x:Name="AuthenticationNavigationStatusLabel" Text="{Binding AuthenticationStatusText}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0" Style="{StaticResource WebOnly}" />
                            </StackPanel>
                        </Border>
                        <WrapPanel Grid.Row="1" Margin="0,12,0,12">
                            <Button Content="{Binding StartActionText}" Command="{Binding StartExplorationCommand}" Style="{StaticResource PrimaryActionButton}" />
                            <Button Content="保存" Command="{Binding SaveCommand}" AutomationProperties.Name="実行画面の変更を保存" />
                            <Button Content="停止" Command="{Binding StopExplorationCommand}" />
                            <Button Content="生成結果を確認 →" Tag="{Binding ReviewPageTag}" Click="Navigate_Click" Style="{StaticResource AuthenticationIdleAction}" />
                            <Button Content="環境チェック" Command="{Binding CheckEnvironmentCommand}" Style="{StaticResource AuthenticationIdleAction}" />
                            <Button Content="MCP接続を設定" Command="{Binding SetupMcpCommand}" Style="{StaticResource AuthenticationIdleAction}" />
                            <Button Content="探索パッケージを生成" Command="{Binding BuildExplorationPackageCommand}" ToolTip="外部実行・調査用に設定ファイルだけを作成します。" Style="{StaticResource AuthenticationIdleAction}" />
                        </WrapPanel>
                        <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="10" Margin="0,0,0,10" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding RunPhase}" FontWeight="SemiBold" Margin="0,0,12,5" />
                                <TextBlock Grid.Column="1" Text="{Binding RunProgressDetail}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,12,5" />
                                <TextBlock Grid.Column="2" Text="{Binding RunProgress, StringFormat={}{0}%}" FontWeight="SemiBold" />
                                <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Minimum="0" Maximum="100" Value="{Binding RunProgress, Mode=OneWay}" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="3" Background="{DynamicResource WarningBackground}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1" Padding="10" Margin="0,0,0,10" CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InterventionText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Button x:Name="ResumeInterventionButton" DockPanel.Dock="Right" Command="{Binding ResumeExplorationCommand}" Style="{StaticResource PrimaryActionButton}" Margin="16,0,0,0" VerticalAlignment="Center" MaxWidth="260">
                                    <TextBlock Text="{Binding ResumeActionText}" TextWrapping="Wrap" TextAlignment="Center" />
                                </Button>
                                <StackPanel>
                                    <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding InterventionText}" TextWrapping="Wrap" />
                                    </ScrollViewer>
                                        <StackPanel>
                                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding AuthenticationWaiting}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                            <TextBlock Text="認証後のロール" Margin="0,8,0,0" />
                                            <ListBox Style="{StaticResource ChoiceList}" x:Name="AuthenticationRoleSelector" ItemsSource="{Binding AuthenticationRoleOptions}" SelectedItem="{Binding AuthenticationRole, Mode=TwoWay}" MinWidth="180" HorizontalAlignment="Left" AutomationProperties.Name="認証後のロール" />
                                        </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <GroupBox Grid.Row="4" Header="実行ログ" Margin="0" Padding="16">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Button DockPanel.Dock="Right" Content="ログを開く" Click="ShowLog_Click" />
                                    <Button DockPanel.Dock="Right" Content="ログをコピー" Click="CopyLog_Click" />
                                    <TextBlock Style="{StaticResource Hint}" Text="新しいログが上に表示されます。選択して Ctrl+C でもコピーできます。" />
                                </DockPanel>
                                <TextBlock x:Name="LogCopyStatus" DockPanel.Dock="Bottom" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                <TextBox x:Name="ExecutionLogTextBox" Text="{Binding ConsoleText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" Background="{DynamicResource ConsoleBackground}" Foreground="{DynamicResource ConsoleForeground}" Padding="10" ContextMenuService.ShowOnDisabled="True" Margin="0">
                                    <TextBox.CommandBindings><CommandBinding Command="ApplicationCommands.Copy" Executed="LogCopy_Executed" CanExecute="LogCopy_CanExecute" /></TextBox.CommandBindings>
                                    <TextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="選択範囲をコピー" Command="ApplicationCommands.Copy" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </TextBox.ContextMenu>
                                </TextBox>
                            </DockPanel>
                        </GroupBox>
                    </Grid>
                </TabItem>
                <TabItem Header="観測した通信" Tag="収集した通信の応答、認証ロール、取得元を確認します。">
                    <Grid Margin="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Project.Requests}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="85" MinWidth="85" />
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusCode}" Width="75" MinWidth="75" />
                                <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*" MinWidth="220" />
                                <DataGridTextColumn Header="認証ロール" Binding="{Binding Role}" Width="180" MinWidth="180" />
                                <DataGridTextColumn Header="Content-Type" Binding="{Binding ContentType}" Width="180" MinWidth="180" />
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="120" MinWidth="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="通信ファイルを取り込む" Click="Import_Click" Style="{StaticResource EditableButton}" />
                            <Button DockPanel.Dock="Right" Content="保存" Command="{Binding SaveCommand}" AutomationProperties.Name="観測した通信を保存" />
                            <TextBlock Text="{Binding RequestSummary}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" />
                        </DockPanel>
                        <Border Grid.Row="1">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource EmptyState}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Project.Requests.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="まだ通信がありません。探索を開始するか、HAR・JSONL・URL一覧を取り込んでください。" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" TextAlignment="Center" />
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="候補レビュー" Tag="代表パターンの判断根拠を確認し、診断対象を採用・除外します。">
                    <Grid Margin="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1.2*" MinHeight="90" />
                            <RowDefinition Height="13" />
                            <RowDefinition Height="*" MinHeight="80" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding CandidateSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <WrapPanel Grid.Row="1">
                                <Button Content="保存" Command="{Binding SaveCommand}" AutomationProperties.Name="候補レビューを保存" />
                                <TextBlock Text="検索" VerticalAlignment="Center" Margin="0,0,8,8" />
                                <TextBox x:Name="CandidateSearchBox" Text="{Binding CandidateSearch, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, Delay=200}" Width="220" Margin="0,0,12,8" AutomationProperties.Name="候補を検索" ToolTip="URL・分類・理由・ロールを検索 (Ctrl+F)" />
                                <Button Content="すべて" Command="{Binding ShowAllCandidatesCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CandidateReviewFilter}" Value="すべて">
                                                    <Setter Property="Background" Value="{DynamicResource Selection}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Link}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="採用のみ" Command="{Binding ShowSelectedCandidatesCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CandidateReviewFilter}" Value="採用">
                                                    <Setter Property="Background" Value="{DynamicResource Selection}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Link}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="除外のみ" Command="{Binding ShowExcludedCandidatesCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CandidateReviewFilter}" Value="除外">
                                                    <Setter Property="Background" Value="{DynamicResource Selection}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Link}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="表示中を採用" Command="{Binding AdoptVisibleCandidatesCommand}" />
                                <Button Content="表示中を除外" Command="{Binding ExcludeVisibleCandidatesCommand}" />
                            </WrapPanel>
                            <DockPanel Grid.Row="2">
                                <Button DockPanel.Dock="Right" Content="候補を再生成" Command="{Binding GenerateCandidatesCommand}" />
                                <Button DockPanel.Dock="Right" Content="判断をリセット" Click="ResetCandidateDecisions_Click" Style="{StaticResource EditableButton}" ToolTip="この案件の採用・除外記録を解除して再判定します。" />
                                <TextBlock Text="{Binding CandidateFilterSummary}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredCandidates}" SelectedItem="{Binding SelectedCandidate}" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" CellEditEnding="CandidateGrid_CellEditEnding" Style="{StaticResource ReviewGrid}" AutomationProperties.Name="診断対象候補">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="採用" Width="64" MinWidth="64">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" Click="CandidateSelection_Click" AutomationProperties.Name="診断対象に採用" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="判定" Binding="{Binding Decision}" Width="85" MinWidth="85" IsReadOnly="True" />
                                <DataGridTextColumn Header="確信度" Binding="{Binding Confidence}" Width="70" MinWidth="70" IsReadOnly="True" />
                                <DataGridTextColumn Header="分類" Binding="{Binding Category}" Width="130" MinWidth="130" IsReadOnly="True" />
                                <DataGridTextColumn Header="Method" Binding="{Binding Representative.Method}" Width="75" MinWidth="75" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="代表URL" Width="*" IsReadOnly="True" MinWidth="260">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Representative.Url}" Tag="{Binding Representative.Url}" Click="CandidateUrl_Click" HorizontalAlignment="Left" Padding="2,0" Margin="0" MinWidth="0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Link}" Cursor="Hand" ToolTip="既定のブラウザで開く" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="類似数" Binding="{Binding SimilarCount}" Width="70" MinWidth="70" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <GroupBox Grid.Row="3" Header="判断の根拠と診断時の注意" Margin="0" Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="一覧で候補を選ぶと、理由・注意点・判断の経緯を表示します。">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedCandidate}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding SelectedCandidate.Reason}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding SelectedCandidate.DiagnosticCaution}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <TextBlock Text="{Binding SelectedCandidate.GuidelineBasis}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12" />
                                    <TextBlock Text="{Binding SelectedCandidate.DecisionTrace}" TextWrapping="Wrap" FontFamily="Consolas, Yu Gothic UI" LineHeight="22" />
                                </StackPanel>
                            </ScrollViewer>
                        </GroupBox>
                        <TextBlock Grid.Row="4" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Text="採用・除外は自動保存されます。除外したパターンは次回のAI確認から外れ、新規パターンと採用済み候補は対象に残ります。" />
                        <GridSplitter Grid.Row="2" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" VerticalAlignment="Center" AutomationProperties.Name="一覧と詳細の高さを調整" />
                        <Border Grid.Row="1">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource EmptyState}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilteredCandidates.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="表示する候補がありません。検索条件を変えるか、探索で通信を収集してください。" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" TextAlignment="Center" />
                        </Border>
                    </Grid>
