                                <TextBlock Text="{Binding BurpHandoffStatus}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <StackPanel Style="{StaticResource BurpOnly}"><StackPanel Style="{StaticResource WebOnly}"><TextBlock Text="登録手順: BurpのTarget &gt; Scopeを開き、Include in scopeで追加します。コピーした値をURL regexへ貼り付け、Protocol・Host・Portが案件の許可Originと一致することを確認します。出力フォルダーには全候補の正規表現、代表URL、JSON証跡、TSV形式の診断作業表も保存されます。" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
                                <StackPanel Style="{StaticResource ApiOnly}"><TextBlock Text="APIモード: ［APIリクエスト］で採用した下書きを、個別の.http、JSON、TSVで出力します。.httpの全文をRepeaterへ貼り付け、接続先のTLS・Host・Portと認証情報・仮値を確認してください。選択した下書きは画面から直接コピーできます。" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel></StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="データ管理" Tag="案件のバックアップと生成データの整理を行います。">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="案件データのバックアップと整理" FontSize="18" FontWeight="SemiBold" />
                            <Border Grid.Row="1" Background="{DynamicResource InfoBackground}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" Padding="14" Margin="0,12,0,12" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding DataSummaryText}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding LastBackupPath}" TextWrapping="Wrap" FontFamily="Consolas" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                            <WrapPanel Grid.Row="2">
                                <Button Content="容量を再集計" Command="{Binding RefreshDataSummaryCommand}" />
                                <Button Content="保存" Command="{Binding SaveCommand}" AutomationProperties.Name="データ管理の変更を保存" />
                                <Button Content="案件をZIPバックアップ" Command="{Binding BackupProjectCommand}" Style="{StaticResource PrimaryActionButton}" />
                                <Button Content="プロジェクトフォルダーを開く" Command="{Binding OpenDataFolderCommand}" />
                            </WrapPanel>
                            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                                <GroupBox Header="データ整理">
                                    <StackPanel>
                                        <TextBlock Text="Web・API・ZAPの実行データは、実行履歴で対象を選択して削除します。ここではBurp出力と案件レポートを整理します。" TextWrapping="Wrap" />
                                        <WrapPanel>
                                            <Button Content="Burp出力と案件レポートを削除" Click="DeleteGeneratedArtifacts_Click" Style="{StaticResource EditableButton}" />
                                        </WrapPanel>
                                        <TextBlock Text="削除前にZIPバックアップを作成すると、案件JSON、探索実行、Burp出力、レポートをまとめて保管できます。" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="APIリクエスト" Tag="API文書から生成した未送信の下書きを確認・編集し、Burpへ渡すリクエストを採用します。">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="2*" MinHeight="130" />
                            <RowDefinition Height="8" /><RowDefinition Height="3*" MinHeight="160" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <WrapPanel DockPanel.Dock="Right">
                                <Button Content="選択したHTTPをコピー" Command="{Binding CopyApiRequestCommand}" />
                                <Button Content="保存" Click="SaveApiRequest_Click" AutomationProperties.Name="APIリクエストを保存" Style="{StaticResource EditableButton}" />
                                <Button Content="Burpへ引き渡し →" Tag="6" Click="Navigate_Click" />
                            </WrapPanel>
                            <TextBlock Text="{Binding ApiRequestSummary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid Grid.Row="1" Style="{StaticResource EditableWhenIdle}">
                            <DataGrid x:Name="ApiRequestsGrid" ItemsSource="{Binding Project.ApiRequests}" SelectedItem="{Binding SelectedApiRequest}" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="採用" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" Click="ApiRequestSelection_Click" HorizontalAlignment="Center" AutomationProperties.Name="APIリクエストの採用" />
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Method" Binding="{Binding Method}" IsReadOnly="True" Width="80" />
                                    <DataGridTextColumn Header="URL" Binding="{Binding Url}" IsReadOnly="True" Width="*" />
                                    <DataGridTextColumn Header="Operation" Binding="{Binding OperationId}" IsReadOnly="True" Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="APIドキュメントモードで文書を読み込み、リクエストを生成してください。生成直後は全件未採用です。" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" TextAlignment="Center">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Project.ApiRequests.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="{DynamicResource Border}" />
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Style="{StaticResource EditableWhenIdle}">
                                <TextBlock Text="{Binding SelectedApiRequest.Summary}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedApiRequest.ReviewNotes}" TextWrapping="Wrap" Margin="0,8" />
                                <TextBlock Text="Method" /><TextBox Text="{Binding SelectedApiRequest.Method, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" />
                                <TextBlock Text="URL" /><TextBox Text="{Binding SelectedApiRequest.Url, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" />
                                <TextBlock Text="ヘッダー（1行に Name: value）" /><TextBox Text="{Binding SelectedApiRequest.HeadersText, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                                <TextBlock Text="本文" /><TextBox Text="{Binding SelectedApiRequest.Body, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" AcceptsReturn="True" AcceptsTab="True" Height="120" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                                <TextBlock Text="Burpへ渡すHTTPテキスト" /><TextBox Text="{Binding SelectedApiRequest.RawRequest, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Height="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="アプリ設定" Tag="ZAP・Burpの実行環境と診断チューニングの既定値を、ユーザー単位で設定します。">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="設定を保存" Command="{Binding SaveAppSettingsCommand}" Style="{StaticResource PrimaryActionButton}" AutomationProperties.Name="アプリ設定を保存" />
                                <Button Content="既定値に戻す" Click="ResetAppSettings_Click" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding AppSettingsPath, StringFormat=設定ファイル: {0}}" TextWrapping="Wrap" Margin="0,0,0,16" />
                            <GroupBox Header="ZAP実行環境（すべての案件で使用する既定）" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="ZAPのJAR（zap*.jar）" />
                                    <Grid Margin="0,4,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding AppSettings.ZapJarPath, UpdateSourceTrigger=PropertyChanged}" Height="38" Margin="0,0,8,0" AutomationProperties.Name="アプリ設定のZAP JAR" />
                                        <Button Grid.Column="1" Content="JARを選択" Click="ChooseAppZapJar_Click" Height="38" MinWidth="96" Margin="0" />
                                    </Grid>
                                    <TextBlock Text="Javaのjava.exe" />
                                    <Grid Margin="0,4,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding AppSettings.JavaPath, UpdateSourceTrigger=PropertyChanged}" Height="38" Margin="0,0,8,0" AutomationProperties.Name="アプリ設定のJava" />
                                        <Button Grid.Column="1" Content="Javaを選択" Click="ChooseAppJava_Click" Height="38" MinWidth="96" Margin="0" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Text="案件設定のZAP・Javaが空欄のときに、ここで指定したパスを使用します。既存の案件で既に指定済みの場合は案件側の指定が優先されます。" TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="ZAPアクティブ診断のチューニング" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="ルールごとの実行上限（分、1〜10）" TextWrapping="Wrap" />
                                            <TextBlock Text="時間差系のルールは値を大きくすると検出しやすくなります（所要時間も増えます）" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Text="{Binding AppSettings.MaxRuleDurationInMins, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ルールごとの実行上限" />
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="ルールごとの警告上限（件、1〜100）" TextWrapping="Wrap" />
                                            <TextBlock Text="同じルールの警告をここまで取り込みます" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Text="{Binding AppSettings.MaxAlertsPerRule, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ルールごとの警告上限" />
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="要求間隔（ミリ秒、0〜1000）" TextWrapping="Wrap" />
                                            <TextBlock Text="対象への負荷を抑える間隔です" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Text="{Binding AppSettings.DelayInMs, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="診断要求の間隔" />
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="ホストごとのスレッド数（1〜4）" TextWrapping="Wrap" />
                                            <TextBlock Text="既定1。増やすと並行リクエストが増え、対象の負荷が上がります" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Text="{Binding AppSettings.ThreadPerHost, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ホストごとのスレッド数" />
                                    </Grid>
                                    <CheckBox Content="すべての要求でヘッダーを診断対象にする（要求数が増えます）" IsChecked="{Binding AppSettings.ScanHeadersAllRequests, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,4" AutomationProperties.Name="ヘッダー診断" />
                                    <CheckBox Content="未観測のパラメーターを診断に追加する（要求数が増えます）" IsChecked="{Binding AppSettings.AddQueryParam, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" AutomationProperties.Name="未観測パラメーターの追加" />
                                    <TextBlock Style="{StaticResource Hint}" Text="これらの値はZAP計画・実行前の再生成検査・承認証跡（zap-active-authorization.json）へ反映されます。値を変更した後に作成済みのパッケージを実行する場合は、パッケージを作り直してください。対象の許可範囲と負荷を確認して調整してください。" TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Burp MCPプロキシ" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="mcp-proxy-all.jarの場所" />
                                    <Grid Margin="0,4,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding AppSettings.BurpMcpProxyJarPath, UpdateSourceTrigger=PropertyChanged}" Height="38" Margin="0,0,8,0" AutomationProperties.Name="Burp MCPプロキシのJAR" />
                                        <Button Grid.Column="1" Content="JARを選択" Click="ChooseAppBurpJar_Click" Height="38" MinWidth="96" Margin="0" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Text="空欄の場合は、環境変数SCOPEPILOT_BURP_PROXY_JAR、次に既定位置（%LOCALAPPDATA%\ScopePilot\mcp\mcp-proxy-all.jar）の順に解決します。配布物には含まれません。" TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="AI連携（Codex・Claude・GLM）" Margin="0,0,0,16">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="すべて確認" Command="{Binding CheckAllAiConnectionsCommand}" Height="34" Margin="8,0,0,0" AutomationProperties.Name="すべてのAIの接続状況を確認" />
                                        <TextBlock Style="{StaticResource Hint}" Text="AIごとに接続状況を確認できます。いずれの確認もモデルへの生成要求（課金対象）は行いません。" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Separator Margin="0,8" />
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="接続を確認" Command="{Binding CheckCodexConnectionCommand}" Height="34" Margin="8,0,0,0" AutomationProperties.Name="Codex CLIの接続状況を確認" />
                                        <TextBlock Text="Codex CLI" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Hint}" Text="codex login status でログイン状態を確認します。" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding CodexConnectionStatusText}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondary}" AutomationProperties.Name="Codex CLIの確認結果" />
                                    <Separator Margin="0,12" />
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="接続を確認" Command="{Binding CheckClaudeConnectionCommand}" Height="34" Margin="8,0,0,0" AutomationProperties.Name="Claude Code CLIの接続状況を確認" />
                                        <TextBlock Text="Claude Code CLI" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Hint}" Text="実行ファイル（%USERPROFILE%\.local\bin または %APPDATA%\npm）と認証情報を確認します。" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ClaudeConnectionStatusText}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondary}" AutomationProperties.Name="Claude Code CLIの確認結果" />
                                    <Separator Margin="0,12" />
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="接続を確認" Command="{Binding CheckGlmConnectionCommand}" Height="34" Margin="8,0,0,0" AutomationProperties.Name="GLMの接続状況を確認" />
                                        <TextBlock Text="GLM（Z.ai・zcode）" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Hint}" Text="zcode CLI（%APPDATA%\npm）と、APIキーまたはZ.aiサインイン（zcode login）を確認します。" TextWrapping="Wrap" />
                                    <TextBlock Text="Z.ai Coding PlanのAPIキー" Margin="0,8,0,0" />
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="GlmApiKeyBox" PasswordChanged="GlmApiKeyBox_PasswordChanged" Height="38" Margin="0,0,8,0" VerticalContentAlignment="Center" AutomationProperties.Name="GLMのAPIキー" />
                                        <Button Grid.Column="1" Content="登録を解除" Command="{Binding ClearGlmApiKeyCommand}" Height="38" MinWidth="96" Margin="0" AutomationProperties.Name="GLMのAPIキーの登録を解除" />
                                    </Grid>
                                    <TextBlock Text="{Binding GlmApiKeyStatusText}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" AutomationProperties.Name="GLMのAPIキーの登録状態" />
                                    <TextBlock Style="{StaticResource Hint}" Text="入力して［設定を保存］で登録します。キーはWindows DPAPI（ユーザー単位）で暗号化して設定ファイルへ保存し、画面・ログ・実行フォルダーには表示・保存しません。登録したキーは環境変数 ZAI_API_KEY（代替 Z_AI_API_KEY）より優先します。キーがない場合は zcode login のサインインで実行します。" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding GlmConnectionStatusText}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondary}" AutomationProperties.Name="GLMの確認結果" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <Button x:Name="ShowLogButton" DockPanel.Dock="Right" Content="ログを表示" Click="ShowLog_Click" MinHeight="28" Padding="8,2" Margin="12,0,0,0" />
                <TextBlock Text="{Binding LatestLog}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" ToolTip="{Binding LatestLog}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
