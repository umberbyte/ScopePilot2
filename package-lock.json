{
  "name": "scopepilot2",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "scopepilot2",
      "workspaces": [
        "apps/*",
        "packages/*",
        "tools/*"
      ],
      "devDependencies": {
        "@types/node": "^24.0.0",
        "typescript": "^5.9.0"
      },
      "engines": {
        "node": ">=24"
      }
    },
    "apps/cli": {
      "name": "@scopepilot2/cli"
    },
    "apps/desktop": {
      "name": "@scopepilot2/desktop"
    },
    "node_modules/@scopepilot2/adapters": {
      "resolved": "packages/adapters",
      "link": true
    },
    "node_modules/@scopepilot2/cli": {
      "resolved": "apps/cli",
      "link": true
    },
    "node_modules/@scopepilot2/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "node_modules/@scopepilot2/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@scopepilot2/desktop": {
      "resolved": "apps/desktop",
      "link": true
    },
    "node_modules/@scopepilot2/simulation": {
      "resolved": "tools/simulation",
      "link": true
    },
    "node_modules/@scopepilot2/storage": {
      "resolved": "packages/storage",
      "link": true
    },
    "node_modules/@scopepilot2/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "node_modules/@types/node": {
      "version": "24.19.2",
      "resolved": "https://registry.npmjs.org/@types/node/-/node-24.19.2.tgz",
      "integrity": "sha512-93d49wCWJkCyN87MxLpNN6KXPCwFw7bVUg79mGUV1OS40JGWwVCr8n61DXCSqz7CV6/VfPkb7xec7uP2M+QHWQ==",
      "dev": true,
      "license": "MIT",
      "dependencies": {
        "undici-types": ">=7.24.0 <7.24.7"
      }
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
      "integrity": "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "node_modules/undici-types": {
      "version": "7.24.6",
      "resolved": "https://registry.npmjs.org/undici-types/-/undici-types-7.24.6.tgz",
      "integrity": "sha512-WRNW+sJgj5OBN4/0JpHFqtqzhpbnV0GuB+OozA9gCL7a993SmU+1JBZCzLNxYsbMfIeDL+lTsphD5jN5N+n0zg==",
      "dev": true,
      "license": "MIT"
    },
    "packages/adapters": {
      "name": "@scopepilot2/adapters"
    },
    "packages/contracts": {
      "name": "@scopepilot2/contracts"
    },
    "packages/core": {
      "name": "@scopepilot2/core",
      "devDependencies": {
        "@scopepilot2/contracts": "*"
      }
