<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ScopePilot.Simulation</AssemblyName>
    <RootNamespace>ScopePilot.Simulation</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ScopePilot.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\tools\fast-crawl.js;..\..\tools\crawl-policy.js;..\..\tools\zap-browser-record.js;..\..\tools\mcp-tool-filter.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>tools\%(Filename)%(Extension)</TargetPath>
    </Content>
    <Content Include="..\..\tools\playwright-runtime\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>tools\playwright-runtime\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>
</Project>
