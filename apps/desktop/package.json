{
  "name": "@scopepilot2/desktop",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main.js",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.js",
    "build:renderer": "esbuild src/renderer/index.tsx --bundle --format=iife --jsx=automatic --outfile=dist/renderer.js && esbuild src/renderer/index.html --loader:.html=copy --outfile=dist/index.html",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "npm run build && electron .",
    "test": "node --test \"test/unit/**/*.test.ts\""
  },
  "devDependencies": {
    "@scopepilot2/contracts": "*",
    "@scopepilot2/core": "*",
    "@scopepilot2/simulation": "*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.9.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
